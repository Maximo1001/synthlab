# Copia a .env y rellena. NUNCA subas .env al repositorio.
SYNTHLAB_ENV=production
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SYNTHLAB_SECRET_KEY=
SYNTHLAB_PUBLIC_URL=https://synthlab.example.com
SYNTHLAB_TRUSTED_HOSTS=synthlab.example.com
# nº de proxies inversos delante (nginx = 1)
SYNTHLAB_TRUSTED_PROXIES=1
SYNTHLAB_INSTANCE_DIR=/var/lib/synthlab
SYNTHLAB_SECURITY_LOG=/var/log/synthlab/seguridad.log

# Correo (console sólo para desarrollo)
SYNTHLAB_MAIL_BACKEND=smtp
SYNTHLAB_MAIL_FROM=SYNTHLAB <no-reply@synthlab.example.com>
SYNTHLAB_SMTP_HOST=
SYNTHLAB_SMTP_PORT=587
SYNTHLAB_SMTP_USER=
SYNTHLAB_SMTP_PASSWORD=

# Política (valores por defecto seguros)
SYNTHLAB_REQUIRE_EMAIL_VERIFICATION=true
SYNTHLAB_ADMIN_REQUIRE_MFA=true
SYNTHLAB_LOCKOUT_THRESHOLD=5
SYNTHLAB_LOCKOUT_MINUTES=15
SYNTHLAB_SESSION_IDLE_MINUTES=30
SYNTHLAB_SESSION_ABSOLUTE_HOURS=12
# Comprobar contraseñas filtradas en HIBP (k-anonimato, sale a Internet)
SYNTHLAB_HIBP_CHECK=false
